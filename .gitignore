# Dataset - AMLNet.csv is ~691 MB, over GitHub's 100 MB limit.
# Download from Zenodo (DOI 10.5281/zenodo.16736515) into data/raw/
data/raw/*.csv
data/processed/*

# Model binaries - regenerated by running the pipeline.
# final_model_config.json IS committed; it records the selected model.
models/*.joblib
models/*.pkl

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.iml

# PyCharm temporary files
tempCodeRunnerFile.py

# OS
.DS_Store
Thumbs.db

# Logs and checkpoints
*.log
.ipynb_checkpoints/

# Streamlit .
.streamlit/secrets.toml